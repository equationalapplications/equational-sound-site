---
import Base from '../layouts/Base.astro';
import { LABEL } from '../data/label';
---

<Base title={`Page not found — ${LABEL.name}`} description="Page not found.">
  <h1>404</h1>
  <p class="lede">That page doesn't exist. Try the <a href={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}>home page</a> or the <a href={`${import.meta.env.BASE_URL}/catalog/`}>catalog</a>.</p>
</Base>
