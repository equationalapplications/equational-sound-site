---
import Base from '../layouts/Base.astro';
import { LABEL } from '../data/label';
import { BASE } from '../lib/base';
---

<Base title={`Page not found — ${LABEL.name}`} description="Page not found.">
  <h1>404</h1>
  <p class="lede">That page doesn't exist. Try the <a href={`${BASE}/`}>home page</a> or the <a href={`${BASE}/catalog/`}>catalog</a>.</p>
</Base>
